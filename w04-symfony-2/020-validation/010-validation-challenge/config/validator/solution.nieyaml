App\Entity\Location:
    properties:
        city:
            - NotBlank:
                  groups: [create,edit]
        country:
            - NotBlank:
                  groups: [create,edit]
        latitude:
            - Range:
                  min: -180
                  max: 180
                  groups: [create, edit]
        longitude:
            - Range:
                  min: -90
                  max: 90
                  groups: [create, edit]
